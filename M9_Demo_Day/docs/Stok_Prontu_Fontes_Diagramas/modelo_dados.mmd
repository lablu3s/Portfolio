erDiagram
  UTILIZADOR ||--o{ VENDAS : "Vendas.Caixa (Ref)"
  CATEGORIAS ||--o{ PRODUTO : classifica
  CATEGORIAS ||--o{ ESTANTE : classifica
  PRODUTO ||--o{ ESTANTE : "associação descrita; cardinalidade a validar"
  VENDAS ||--o{ ITENS_VENDA : contem
  PRODUTO ||--o{ ITENS_VENDA : "campo Produto (Ref)"
  ESTANTE o|..o{ ITENS_VENDA : "texto da relação sugere stock em Estante; confirmar"
  CONTABILIDADE_DIARIA }o..o{ VENDAS : agrega

  UTILIZADOR {
    string Email PK
    string Nome
    string Perfil "Admin | Caixa | Operador"
  }
  CATEGORIAS {
    string Nome_Categoria "campo descrito; chave técnica não indicada"
  }
  PRODUTO {
    string ID_Produto PK
    string Nome_Produto
    string Categoria FK
    decimal Preco
    string Foto
    string Descricao
  }
  ESTANTE {
    string ID_Estante PK
    string Nome_Produto
    string Categoria FK
    int Stock_Inicial
    int Quantidade_Stock
    decimal Preco_Unitario
    datetime Ultimo_Registo
  }
  VENDAS {
    string ID_Venda PK
    datetime Data_hora
    string Caixa FK
    string Estado "Aberta | Finalizada"
    decimal Valor_Entregue
    decimal Valor_Total
  }
  ITENS_VENDA {
    string ID_Item PK
    string Venda FK
    string Produto FK
    int Quantidade
    decimal IVA
    decimal Subtotal
  }
  CONTABILIDADE_DIARIA {
    string ID_Fecho PK
    datetime Data
    decimal Total_Vendas_Dia
    int Total_Itens_Vendidos
    int Total_Transacoes
    string Observacoes
  }
